# The image is built with roll_pipeline/ as the context, so the repo-root
# .dockerignore does not apply here.
.venv
__pycache__
**/__pycache__
*.pyc
.pytest_cache

# tests and one-off analysis scripts are not part of the runtime
tests
scripts
out

# local artefacts that must never reach the image
.env
.env.*
!.env.example
*.xlsx
*.csv
*.parquet
*.zip
*.log
